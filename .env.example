# LLM (one of the two). Nothing runs against a provider without a key.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4-6

# Langfuse: optional. Silent when unset; enables cost and trace tables when set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Evals
EVAL_SEED=42
